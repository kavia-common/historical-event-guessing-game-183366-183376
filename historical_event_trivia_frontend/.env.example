# Frontend environment variables
# Point the frontend to the backend API base URL.
# The frontend uses fetch(..., { credentials: 'include' }) to send cookies.
# If you change the backend port or host, update this accordingly.

# Local development (Flask backend default port below)
REACT_APP_API_BASE=http://localhost:3001

# When deploying behind a different hostname/port:
# REACT_APP_API_BASE=https://api.example.com
